{
  "$defs": {
    "HelloConfig": {
      "additionalProperties": true,
      "description": "``VoidConfig.public_subset()``: what the renderer is told (no prices, no thresholds).",
      "properties": {
        "daily_cap_usd": {
          "title": "Daily Cap Usd",
          "type": "number"
        },
        "days": {
          "title": "Days",
          "type": "integer"
        },
        "degeneration_mode": {
          "default": "both",
          "enum": [
            "induce",
            "observe",
            "both"
          ],
          "title": "Degeneration Mode",
          "type": "string"
        },
        "intelligence": {
          "anyOf": [
            {
              "$ref": "#/$defs/IntelligencePublic"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "memory_layer": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemoryLayerPublic"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "population_cap": {
          "title": "Population Cap",
          "type": "integer"
        },
        "render_delay_ticks": {
          "title": "Render Delay Ticks",
          "type": "integer"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "tick_seconds": {
          "title": "Tick Seconds",
          "type": "number"
        },
        "ticks_per_day": {
          "title": "Ticks Per Day",
          "type": "integer"
        },
        "tiers": {
          "additionalProperties": {
            "$ref": "#/$defs/TierPublic"
          },
          "title": "Tiers",
          "type": "object"
        },
        "total_cap_usd": {
          "title": "Total Cap Usd",
          "type": "number"
        },
        "view_radius": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fog radius (world.view_radius); null without fog",
          "title": "View Radius"
        },
        "world_size": {
          "title": "World Size",
          "type": "number"
        }
      },
      "required": [
        "name",
        "seed",
        "days",
        "ticks_per_day",
        "tick_seconds",
        "render_delay_ticks",
        "world_size",
        "population_cap",
        "daily_cap_usd",
        "total_cap_usd",
        "tiers"
      ],
      "title": "HelloConfig",
      "type": "object"
    },
    "IntelligencePublic": {
      "properties": {
        "ladder": {
          "description": "Tier names from smartest to dumbest; empty without a ladder",
          "items": {
            "type": "string"
          },
          "title": "Ladder",
          "type": "array"
        }
      },
      "title": "IntelligencePublic",
      "type": "object"
    },
    "MemoryLayerPublic": {
      "description": "Which parts of the evolving-memory layer are on (MEMORY_EVOLUTION \u00a75), so memory-only views can hide.",
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "exam": {
          "title": "Exam",
          "type": "boolean"
        },
        "maintenance": {
          "title": "Maintenance",
          "type": "boolean"
        },
        "policy": {
          "title": "Policy",
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "policy",
        "maintenance",
        "exam"
      ],
      "title": "MemoryLayerPublic",
      "type": "object"
    },
    "TierPublic": {
      "properties": {
        "collapse_temperature": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "T_c, so the T_eff histogram can draw it from the start",
          "title": "Collapse Temperature"
        },
        "color": {
          "title": "Color",
          "type": "string"
        },
        "max_temperature": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Temperature"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "rank": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rung on intelligence.ladder (0 = smartest); null off the ladder",
          "title": "Rank"
        }
      },
      "required": [
        "color",
        "model",
        "provider"
      ],
      "title": "TierPublic",
      "type": "object"
    }
  },
  "$id": "https://void.local/schemas/hello.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "config": {
      "$ref": "#/$defs/HelloConfig"
    },
    "day": {
      "title": "Day",
      "type": "integer"
    },
    "last_seq": {
      "description": "Highest events.seq at connect time; catch up with GET /api/events?since_seq=",
      "title": "Last Seq",
      "type": "integer"
    },
    "paused": {
      "title": "Paused",
      "type": "boolean"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "server_ts_ms": {
      "title": "Server Ts Ms",
      "type": "number"
    },
    "status": {
      "enum": [
        "running",
        "completed",
        "capped_total",
        "extinct",
        "inconsistent",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "tick": {
      "title": "Tick",
      "type": "integer"
    },
    "tick_seconds": {
      "title": "Tick Seconds",
      "type": "number"
    },
    "type": {
      "const": "hello",
      "default": "hello",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "config",
    "tick",
    "day",
    "last_seq",
    "paused",
    "tick_seconds",
    "server_ts_ms",
    "status"
  ],
  "title": "Hello",
  "type": "object"
}
