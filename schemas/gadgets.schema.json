{
  "$defs": {
    "GadgetItem": {
      "properties": {
        "created_tick": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created Tick"
        },
        "effect_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "One of world.effect_caps' kinds (e.g. forage_bonus)",
          "title": "Effect Kind"
        },
        "effect_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The verified effect size, capped by world.effect_caps",
          "title": "Effect Value"
        },
        "failures": {
          "default": 0,
          "title": "Failures",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "owner": {
          "title": "Owner",
          "type": "string"
        },
        "purpose": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purpose"
        },
        "render": {
          "$ref": "#/$defs/GadgetRender"
        },
        "uses": {
          "default": 0,
          "title": "Uses",
          "type": "integer"
        },
        "verified_without_tests": {
          "default": false,
          "title": "Verified Without Tests",
          "type": "boolean"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "id",
        "name",
        "owner",
        "x",
        "y",
        "render"
      ],
      "title": "GadgetItem",
      "type": "object"
    },
    "GadgetRender": {
      "additionalProperties": true,
      "properties": {
        "color": {
          "title": "Color",
          "type": "string"
        },
        "height_offset": {
          "default": 0.0,
          "title": "Height Offset",
          "type": "number"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "rotation_deg": {
          "default": 0.0,
          "title": "Rotation Deg",
          "type": "number"
        },
        "scale": {
          "default": 1.0,
          "title": "Scale",
          "type": "number"
        },
        "shape": {
          "title": "Shape",
          "type": "string"
        }
      },
      "required": [
        "shape",
        "color"
      ],
      "title": "GadgetRender",
      "type": "object"
    }
  },
  "$id": "https://void.local/schemas/gadgets.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/GadgetItem"
      },
      "title": "Items",
      "type": "array"
    },
    "rev": {
      "title": "Rev",
      "type": "integer"
    },
    "type": {
      "const": "gadgets",
      "default": "gadgets",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "rev",
    "items"
  ],
  "title": "GadgetsMsg",
  "type": "object"
}
